# Project defaults applied when sdkconfig is generated.
# The board reports 16 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 4 MB app + 6 MB ESP-SR model + ~5.9 MB SPIFFS.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Build only the LVGL code we use.
CONFIG_LV_BUILD_EXAMPLES=n

# Better fit for the 1-bit SSD1306 than the default theme.
CONFIG_LV_USE_THEME_MONO=y

# WakeNet needs PSRAM and a faster CPU.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Built-in WakeNet9 "Xiao Ai Tong Xue" (小爱同学) model.
CONFIG_SR_WN_WN9_XIAOAITONGXUE=y

# ES7210 ADC + ES8311 DAC/PA codec drivers.
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=y
